# ── Veer — environment ────────────────────────────────────────────────
# Copy to .env.local for local dev, or set these in Render → Environment.

# Supabase Postgres — use the SESSION POOLER string (IPv4-friendly; the direct
# db.<ref>.supabase.co host is IPv6-only and fails on Render).
# Dashboard → Project Settings → Database → Connection string → "Session pooler" (URI).
# Replace [YOUR-PASSWORD] with the DB password; %-encode specials (? -> %3F).
DATABASE_URL=postgresql://postgres.nwdquveqyluepoqbuosg:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase API — used only for interview-video storage.
SUPABASE_URL=https://nwdquveqyluepoqbuosg.supabase.co
# Dashboard → Project Settings → API → service_role (secret). Keep this private.
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie encryption — any random string, 32+ chars.
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Admin panel login (seeded on first boot).
ADMIN_EMAIL=admin@veer.ie
ADMIN_PASSWORD=change-this

# Optional — real outbound email (leave blank to just log emails).
EMAIL_FROM=Veer <noreply@veer.ie>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
